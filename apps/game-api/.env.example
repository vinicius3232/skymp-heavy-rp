# Porta que o launcher chama (VITE_API_PORT no .env do launcher).
GAME_API_PORT=7758
# 0.0.0.0 porque jogadores conectam de fora. Use firewall pra restringir.
GAME_API_BIND_HOST=0.0.0.0

# Capacidade de slots. Acima disso, jogadores entram na fila.
QUEUE_CAPACITY=40

# Validade da sessao de jogo gravada em `game_sessions` (12h). Precisa cobrir
# uma sessao inteira com folga pra reconectar depois de um crash — o servidor
# de jogo consulta o master API a cada conexao. Absoluto, sem renovacao
# automatica (AUTH-002 decisao 2) — teto de 24h (86400), o servico recusa
# subir com um valor acima disso.
GAME_SESSION_TTL_SECONDS=43200

# Caminho do manifesto de paridade gerado por scripts/generate-mods-manifest.js.
MODS_MANIFEST_PATH=./mods.json

# Mesmo segredo do apps/web e apps/bot-discord — protege /internal/*.
INTERNAL_API_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=skymp_rp
