DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
WHITELIST_ROLE_ID=
INTERNAL_API_SECRET=
PORT=3002

# Onde o bot pergunta quem é staff. Ele NÃO lê o banco e NÃO decide sozinho:
# manda `{discordId, permission}` para POST /internal/authorize do painel, que
# resolve pelo catálogo único (skymp/gamemode/core/permissions.js).
#
# `STAFF_ROLE_ID` foi REMOVIDO. O bot aceitava quem tivesse aquele cargo do
# Discord ou a permissão Administrator da guild — uma quarta fonte de autoridade
# fora de `staff_roles`, em que promover no Discord dava poder que o servidor de
# jogo não reconhecia. Cargo do Discord não é autoridade sobre nada.
#
# Se o painel estiver fora do ar, os comandos de staff do bot NEGAM.
PANEL_INTERNAL_URL=http://127.0.0.1:3001

# Canais de voz temporários (/voz-criar, /voz-fechar) — alternativa prática
# enquanto o VOIP nativo in-game depende de um patch de client que ainda
# não existe (ver docs/technical/VOICE_CLIENT_PATCH.md).
# Exigem a capability `voice.mute` (moderador+).
VOICE_CATEGORY_ID=

# Log de moderação (ARCHITECTURE.md 1.3). ID do canal de texto que recebe
# ban / kick / permakill / decisão de whitelist.
#
# Deixar vazio DESLIGA o envio — o endpoint continua respondendo 202 e nada é
# postado. É uma escolha de operação válida: servidor que não quer o canal não
# pode ver um `/permakill` falhar por causa disso.
#
# O canal deve ser privado da staff: os embeds trazem motivo de kick e notas de
# revisão de whitelist, que são texto que a staff escreveu sobre um jogador.
MODERATION_LOG_CHANNEL_ID=
