{
  "name": "launcher-temp",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//test": "Logica pura de paridade de modpack. O resto do main.ts depende de Electron e nao e testavel sem ele.",
    "test": "node --test electron/parity.test.mjs electron/voice-dist.test.mjs",
    "typecheck": "tsc -b",
    "//build": "`tsc -b` e nao `tsc`: o tsconfig.json da raiz e um solution file com `files: []`, entao `tsc` sozinho nao checava projeto nenhum — o build passava com erro de tipo em src/ e em electron/.",
    "build": "tsc -b && vite build && electron-builder",
    "start": "electron .",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.0.10"
  },
  "license": "AGPL-3.0-or-later"
}
