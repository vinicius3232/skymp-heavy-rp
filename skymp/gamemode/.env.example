# Escolhe QUAL arquivo de opcoes de gameplay o servidor le:
# `skymp/config/server-options.<NODE_ENV>.json` (ver core/server-options.js).
#
# Precisa ser um dos ambientes que existem: `local`, `staging` ou `production`.
# Ate 06/08/2026 este exemplo dizia `development`, e nao existe
# `server-options.development.json` — o Initialize-LocalConfig.ps1 gera
# `server-options.local.json`. O boot avisava
# "server-options.development.json nao encontrado, usando defaults" e seguia,
# entao TODA opcao de gameplay do arquivo era ignorada em silencio: mexer em
# `permadeathEnabled`, nos raios de chat ou no `startingGold` nao fazia nada.
#
# Descoberto no primeiro boot real do servidor (Fase 0).
NODE_ENV=local
ALLOW_LOCAL_AUTOWHITELIST=false

# ─────────────────────────────────────────────────────────────────────────────
# Modulos. Estas sao as UNICAS flags que ligam alguma coisa: cada uma
# corresponde a um `enabledBy` de um descriptor registrado em phase0-basic.js
# (ver core/module-registry.js). Flag sem descriptor nao faz nada.
#
# A Fase 0 mantem tudo desligado por padrao — ver docs/technical/FASE_0_ROTEIRO.md
# pra quais ligar durante o teste in-game.
# ─────────────────────────────────────────────────────────────────────────────
# Interaction Framework — o pipeline de acoes contextuais (menu de interacao).
#
# ⚠️ PRE-REQUISITO de ENABLE_GOVERNANCE_SERVICE e ENABLE_MARKET_STALLS_SERVICE:
# os dois declaram `dependencies: ['interaction']` porque registram acoes nele
# durante o initialize. Sem esta flag, os dois FALHAM no boot — com o motivo no
# log, nomeando a dependencia:
#
#   [module-registry] market-stalls: FALHOU — dependencias nao ativas: interaction
#
# Nao tem gameplay proprio: sozinho ele so abre um canal de UI que ninguem usa.
# Ver docs/framework/INTERACTION_FRAMEWORK.md.
ENABLE_INTERACTION_FRAMEWORK=false

ENABLE_NPC_CLEANER=false
ENABLE_DEATH_SERVICE=false
ENABLE_GOVERNANCE_SERVICE=false
ENABLE_MARKET_STALLS_SERVICE=false
ENABLE_PLAYER_PANEL_SERVICE=false
ENABLE_VOIP_SERVICE=false
ENABLE_SOUL_SERVICE=false
# Nametag visual — PROVA DE CONCEITO, uma etiqueta (o personagem mais proximo).
# Nunca apareceu na tela de ninguem: a projecao mundo->tela usa uma API
# documentada pelo SkyMP que este projeto nunca chamou. Ligue so em bancada, com
# dois clientes, pra descobrir se ela funciona. Ver nametag-service.js §4.
ENABLE_NAMETAG_SERVICE=false

# Troca entre jogadores (trade-service).
#
# Reescrito em 13/08/2026 sobre o Inventory Framework: sessao autoritativa no
# servidor, confirmacao por VERSAO da oferta (qualquer mudanca derruba as duas
# confirmacoes), timeout obrigatorio e commit das duas pernas numa transacao so.
#
# NAO tem UI CEF: os comandos de chat (/trade, /tradeaccept, /tradeadd,
# /tradeconfirm, /tradecancel) sao a interface inteira. Depende de
# ENABLE_INTERACTION_FRAMEWORK para a acao "Propor negocio" aparecer no menu.
#
# Ver docs/gameplay/TRADE_SYSTEM.md.
ENABLE_TRADE_SERVICE=false

# Trabalhos livres (bicos): /cortarlenha, /garimpar, /pescar. Sem profissão,
# sem rank — qualquer personagem carregado pode fazer. Reativado em 20/08/2026
# depois da migração para o transaction-service (ver jobs-service.js).
ENABLE_JOBS_SERVICE=false

# Contratos entre jogadores: /contratocriar, /contratoaceitar,
# /contratoentregar, /contratocontestar, /contratoacertar, /contratocancelar,
# /contratolistar, /contratoinfo. Move ouro de verdade via escrow — nunca
# rodou num servidor com gente dentro. Ver contracts-service.js.
ENABLE_CONTRACTS_SERVICE=false

# ── Instrumentos de observacao da Fase 0 (mobs hostis) ───────────────────────
#
# NAO sao mecanica. Sao as Pecas 1 e 2 da secao 16 de
# docs/technical/HOSTILE_MOB_ACTIVATION_DECISION.md — as duas perguntas cuja
# resposta decide se a feature de caca existe. Protocolo de uso em
# docs/technical/FAUNA_CENSUS_PROTOCOL.md. Ligue so durante a sessao de
# observacao e volte pra false depois.
#
# Censo: somente leitura. Nao desabilita, nao habilita, nao apaga, nao da item.
ENABLE_FAUNA_CENSUS=false
# Sonda de cadaver: ESCREVE. Esvazia o inventario do ator sondado pra provar que
# a escrita funciona, e restaura em seguida. Recusa qualquer ator de jogador.
# Flag separada do censo de proposito.
ENABLE_CORPSE_PROBE=false

# Removidas em 06/08/2026: ENABLE_JUSTICE_SERVICE, ENABLE_FACTION_SERVICE e
# ENABLE_SURVIVAL_SERVICE. Os tres servicos foram APAGADOS (ver
# docs/technical/PARKED_SERVICES_DECISION.md) e as flags ficaram para tras —
# um arquivo de exemplo oferecendo o que nao existe mais convida a ligar e
# concluir que o servidor esta quebrado quando nada acontece.
#
# ENABLE_REGIONAL_ECONOMY tambem saiu: `economy-regional` esta PARKED e nao
# tem descriptor no registry, entao a flag nunca ligou o modulo. O que ela
# fazia era pior — o governance-service a lia direto de process.env pra
# carregar o modulo por fora do registry. Isso foi fechado; hoje quem responde
# e `moduleRegistry.isEnabled()`.
#
# Para reativar qualquer um deles: escreva o descriptor em phase0-basic.js.
# A flag e a ultima etapa, nunca a primeira.

# VOIP — servidor de sinalização WebSocket para voz por proximidade (/voz).
# BIND_HOST é onde o processo escuta (127.0.0.1 = só a própria máquina).
# PUBLIC_HOST é o que o servidor manda pro cliente conectar — troque pro IP
# público do servidor em produção, já que skymp/ui/index.html é estático e
# não tem como descobrir isso sozinho.
VOIP_PORT=7778
VOIP_BIND_HOST=127.0.0.1
VOIP_PUBLIC_HOST=127.0.0.1

# VOICE_BACKEND — por onde a voz trafega. NÃO liga nem desliga a voz; quem faz
# isso é ENABLE_VOIP_SERVICE acima. São perguntas diferentes.
#
#   legacy   (padrão) helper nativo → WebSocket PCM → voip-service → UI.
#                     É o caminho que existe e o único implementado hoje.
#   livekit           captura publica direto num SFU LiveKit. Ainda NÃO captura
#                     áudio: os endpoints estão declarados e o transporte está
#                     provado por spike, a captura não. Ligar isto hoje faz o
#                     servidor subir avisando que a voz não vai sair.
#
# Ver docs/technical/SKYVOICE_LIVEKIT_AUDIT.md e core/voice/voice-endpoint.js.
VOICE_BACKEND=legacy

# Credenciais do LiveKit. Só têm efeito com VOICE_BACKEND=livekit.
#
# ⚠️ LIVEKIT_API_SECRET nunca vai para o cliente. O gamemode assina um access
# token curto com ele e manda o TOKEN — quem tem o secret forja qualquer
# identidade em qualquer sala. Mesma regra do ticket do caminho legado: o
# servidor emite, o cliente apresenta.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Afinidade da Alma (ENABLE_SOUL_SERVICE)
#
# A alma de cada personagem vem de HMAC(SOUL_SECRET, ficha aprovada) — ver
# docs/design/SOUL_AFFINITY.md §III.3. A ficha e PUBLICA no painel; o segredo e
# a unica coisa que impede qualquer pessoa de calcular a alma de qualquer
# personagem a partir dela.
#
# ⚠️ NUNCA saia do servidor, nunca entre em commit, nunca va pro painel web.
# Gere um valor longo e aleatorio, por exemplo:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ TROCAR O SEGREDO DEPOIS MUDA A ALMA de todo personagem que ainda nao foi
# derivado, e deixa incoerentes os que ja foram (a alma e congelada no primeiro
# spawn, de proposito). Escolha uma vez e guarde.
#
# O modulo FALHA NO BOOT se a flag estiver ligada e esta variavel vazia. Isso e
# deliberado: alma derivada de segredo vazio e pior que alma nenhuma.
SOUL_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Log de moderação no Discord (ARCHITECTURE.md 1.3)
#
# Quando as duas variáveis abaixo estão preenchidas, `/kick` e `/permakill`
# avisam o bot, que posta no canal de moderação. Vazias, o envio fica desligado
# e nada é logado além de uma linha no boot.
#
# `INTERNAL_API_SECRET` precisa ser o MESMO valor do `.env` do bot e do painel —
# é o segredo que os três compartilham para falar entre si.
#
# O registro de verdade continua sendo `audit_logs`, escrito antes desta
# chamada: se o bot estiver fora, a moderação acontece do mesmo jeito.
BOT_INTERNAL_URL=http://127.0.0.1:3002
INTERNAL_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Rate limit de eventos da CEF
#
# Por padrao o servidor apenas MEDE: sem estes valores nada e rejeitado, e as
# metricas saem no log a cada 60s. A disciplina e deliberada — limitar antes de
# medir estrangula a UI com um numero que ninguem observou.
#
# UI_EVENT_RATE_LIMIT_MAX_EVENTS  teto global por (ator, tipo) na janela
# UI_EVENT_RATE_LIMIT_WINDOW_MS   janela global, padrao 60000
# INTERACTION_EXECUTE_RATE_LIMIT  teto so de `interaction:execute`
#
# O ultimo existe porque consultar e executar tem perfis opostos:
# `interaction:query` acontece a cada mira (barato, sem efeito colateral) e
# `interaction:execute` move ouro (caro, irreversivel). Um teto unico ou
# estrangula o primeiro ou libera o segundo.
# ─────────────────────────────────────────────────────────────────────────────
# UI_EVENT_RATE_LIMIT_MAX_EVENTS=
# UI_EVENT_RATE_LIMIT_WINDOW_MS=
# INTERACTION_EXECUTE_RATE_LIMIT=
